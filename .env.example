# LLM API Settings
# Options: openai, gemini, or mock (for testing without API key)
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Optional Gemini configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ASR Settings
# Options: whisper_api, whisper_local, or mock
ASR_PROVIDER=whisper_api
WHISPER_MODEL=base

# Database Settings
DATABASE_URL=sqlite:///./meetings.db

# Storage Settings
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
